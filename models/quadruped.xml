<mujoco model="quadruped">
  <option cone="elliptic" impratio="1000" solver="Newton" integrator="implicitfast" timestep="0.001"/>

  <default>
    <geom friction="1 0.005 0.0001"/>
    <motor gear="1"/>
  </default>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="20 20 0.1" rgba="0.5 0.5 0.5 1"/>

    <body name="body" pos="0 0 0.66568542">
      <freejoint name="base"/>
      <geom name="body" type="box" size="0.5 0.15 0.15" mass="10" rgba="0.3 0.4 0.7 1"/>

      <body name="rear_left_hip" pos="-0.4 0.25 0">
        <joint name="rear_left_abad" type="hinge" axis="1 0 0"/>
        <geom name="rear_left_hip" type="box" size="0.05 0.05 0.05" mass="0.5"/>
        <body name="rear_left_thigh" pos="0 0 0">
          <joint name="rear_left_hip" type="hinge" axis="0 -1 0"/>
          <geom name="rear_left_thigh" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
          <body name="rear_left_shin" pos="0.4 0 0">
            <joint name="rear_left_knee" type="hinge" axis="0 -1 0"/>
            <geom name="rear_left_shin" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
            <geom name="rear_left_foot" type="sphere" pos="0.4 0 0" size="0.1" mass="0.1" group="2"/>
          </body>
        </body>
      </body>
      <body name="rear_right_hip" pos="-0.4 -0.25 0">
        <joint name="rear_right_abad" type="hinge" axis="1 0 0"/>
        <geom name="rear_right_hip" type="box" size="0.05 0.05 0.05" mass="0.5"/>
        <body name="rear_right_thigh" pos="0 0 0">
          <joint name="rear_right_hip" type="hinge" axis="0 -1 0"/>
          <geom name="rear_right_thigh" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
          <body name="rear_right_shin" pos="0.4 0 0">
            <joint name="rear_right_knee" type="hinge" axis="0 -1 0"/>
            <geom name="rear_right_shin" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
            <geom name="rear_right_foot" type="sphere" pos="0.4 0 0" size="0.1" mass="0.1" group="2"/>
          </body>
        </body>
      </body>
      <body name="front_left_hip" pos="0.4 0.25 0">
        <joint name="front_left_abad" type="hinge" axis="1 0 0"/>
        <geom name="front_left_hip" type="box" size="0.05 0.05 0.05" mass="0.5"/>
        <body name="front_left_thigh" pos="0 0 0">
          <joint name="front_left_hip" type="hinge" axis="0 -1 0"/>
          <geom name="front_left_thigh" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
          <body name="front_left_shin" pos="0.4 0 0">
            <joint name="front_left_knee" type="hinge" axis="0 -1 0"/>
            <geom name="front_left_shin" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
            <geom name="front_left_foot" type="sphere" pos="0.4 0 0" size="0.1" mass="0.1" group="2"/>
          </body>
        </body>
      </body>
      <body name="front_right_hip" pos="0.4 -0.25 0">
        <joint name="front_right_abad" type="hinge" axis="1 0 0"/>
        <geom name="front_right_hip" type="box" size="0.05 0.05 0.05" mass="0.5"/>
        <body name="front_right_thigh" pos="0 0 0">
          <joint name="front_right_hip" type="hinge" axis="0 -1 0"/>
          <geom name="front_right_thigh" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
          <body name="front_right_shin" pos="0.4 0 0">
            <joint name="front_right_knee" type="hinge" axis="0 -1 0"/>
            <geom name="front_right_shin" type="box" pos="0.2 0 0" size="0.2 0.05 0.05" mass="2"/>
            <geom name="front_right_foot" type="sphere" pos="0.4 0 0" size="0.1" mass="0.1" group="2"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="rear_left_abad" joint="rear_left_abad" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="rear_left_hip" joint="rear_left_hip" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="rear_left_knee" joint="rear_left_knee" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="rear_right_abad" joint="rear_right_abad" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="rear_right_hip" joint="rear_right_hip" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="rear_right_knee" joint="rear_right_knee" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="front_left_abad" joint="front_left_abad" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="front_left_hip" joint="front_left_hip" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="front_left_knee" joint="front_left_knee" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="front_right_abad" joint="front_right_abad" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="front_right_hip" joint="front_right_hip" ctrllimited="true" ctrlrange="-30 30"/>
    <motor name="front_right_knee" joint="front_right_knee" ctrllimited="true" ctrlrange="-30 30"/>
  </actuator>

  <keyframe>
    <!-- base: x y z qw qx qy qz | per leg (rear_left, rear_right, front_left, front_right): abad hip knee -->
    <key name="stand" qpos="0 0 0.66568542 1 0 0 0  0 -0.78539816 -1.57079633  0 -0.78539816 -1.57079633  0 -2.35619449 1.57079633  0 -2.35619449 1.57079633"/>
  </keyframe>
</mujoco>
